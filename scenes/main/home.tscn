[ext_resource type="Script" path="res://scripts/ui/effects/glow_cta.gd" id="5_glowcta"]
[ext_resource type="PackedScene" uid="uid://b0navlinkbtn001" path="res://scenes/ui/components/nav_link_button.tscn" id="6_navlink"]
[ext_resource type="Script" path="res://scripts/ui/components/mascot_controller.gd" id="7_mascot"]
[ext_resource type="PackedScene" uid="uid://b0brainagecard1" path="res://scenes/ui/components/brain_age_card.tscn" id="8_brainage"]
[ext_resource type="PackedScene" uid="uid://b0dailyscorecard" path="res://scenes/ui/components/daily_score_card.tscn" id="9_score"]
[ext_resource type="PackedScene" uid="uid://b0ghostrecstrip" path="res://scenes/ui/components/ghost_record_strip.tscn" id="10_ghost"]
