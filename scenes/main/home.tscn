[ext_resource type="PackedScene" uid="uid://b0sumiradar0001" path="res://scenes/ui/components/sumi_radar_chart.tscn" id="12_radar"]
[ext_resource type="PackedScene" uid="uid://b0dailychalleng" path="res://scenes/ui/components/daily_challenge_strip.tscn" id="13_daily"]

; ----- 設定ボタンの styleBox（非ホバー=透明 / ホバー=和紙ピル） -----
[sub_resource type="StyleBoxEmpty" id="StyleBoxEmpty_settings"]
content_margin_left = 8.0
content_margin_top = 8.0
content_margin_right = 8.0
content_margin_bottom = 8.0

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_settings_hover"]
content_margin_left = 8.0
content_margin_top = 8.0
content_margin_right = 8.0
content_margin_bottom = 8.0
bg_color = Color(0.839, 0.812, 0.745, 0.7)
corner_radius_top_left = 9999
corner_radius_top_right = 9999
corner_radius_bottom_right = 9999
corner_radius_bottom_left = 9999

; ====================================================================
; ルート
; ====================================================================
[node name="Home" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_home")

[node name="WashiBackground" type="TextureRect" parent="."]
texture = ExtResource("2_washibg")
expand_mode = 1
stretch_mode = 6
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
z_index = -100

[node name="SafeArea" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 56
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 48

[node name="MainColumn" type="VBoxContainer" parent="SafeArea"]
layout_mode = 2
theme_override_constants/separation = 16

; ====================================================================
; TopRow: 脳年齢カード(コンポーネント) + 設定ボタン
; ====================================================================
[node name="TopRow" type="HBoxContainer" parent="SafeArea/MainColumn"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="BrainAgeCard" parent="SafeArea/MainColumn/TopRow" instance=ExtResource("8_brainage")]
layout_mode = 2
size_flags_horizontal = 3

[node name="SettingsButton" type="Button" parent="SafeArea/MainColumn/TopRow"]
custom_minimum_size = Vector2(64, 64)
layout_mode = 2
size_flags_vertical = 0
theme_override_styles/normal = SubResource("StyleBoxEmpty_settings")
theme_override_styles/hover = SubResource("StyleBoxFlat_settings_hover")
theme_override_styles/pressed = SubResource("StyleBoxFlat_settings_hover")
theme_override_colors/font_color = Color(0.42, 0.42, 0.447, 1)
theme_override_fonts/font = ExtResource("4_msym")
theme_override_font_sizes/font_size = 44
text = "settings"
flat = false

; ====================================================================
; HeroRow: マスコット + 吹き出し (既存維持)
; ====================================================================
[node name="HeroRow" type="HBoxContainer" parent="SafeArea/MainColumn"]
custom_minimum_size = Vector2(0, 212)
layout_mode = 2
alignment = 1
theme_override_constants/separation = 8

[node name="MascotController" type="Node" parent="SafeArea/MainColumn/HeroRow"]
script = ExtResource("7_mascot")
mascot_sprite = NodePath("../MascotImage")

[node name="SpeechWrap" type="Control" parent="SafeArea/MainColumn/HeroRow"]
custom_minimum_size = Vector2(180, 80)
layout_mode = 2
size_flags_horizontal = 0
size_flags_vertical = 4
mouse_filter = 2

[node name="SpeechBubble" type="PanelContainer" parent="SafeArea/MainColumn/HeroRow/SpeechWrap"]
layout_mode = 1
anchors_preset = 6
anchor_left = 1.0
anchor_top = 0.5
anchor_right = 1.0
anchor_bottom = 0.5
offset_left = -176.0
offset_top = -28.0
offset_bottom = 28.0
grow_horizontal = 0
grow_vertical = 2
theme_type_variation = &"pill_chip"

[node name="Margin" type="MarginContainer" parent="SafeArea/MainColumn/HeroRow/SpeechWrap/SpeechBubble"]
layout_mode = 2
theme_override_constants/margin_left = 14
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 14
theme_override_constants/margin_bottom = 8

[node name="SpeechText" type="Label" parent="SafeArea/MainColumn/HeroRow/SpeechWrap/SpeechBubble/Margin"]
layout_mode = 2
theme_type_variation = &"h2"
text = "おかえり！
今日もやる？"
horizontal_alignment = 1

[node name="MascotImage" type="TextureRect" parent="SafeArea/MainColumn/HeroRow"]
custom_minimum_size = Vector2(200, 212)
layout_mode = 2
size_flags_horizontal = 0
texture = ExtResource("3_mascot")
expand_mode = 1
stretch_mode = 5

; ====================================================================
; DailyScoreCard (コンポーネント)
; ====================================================================
[node name="DailyScoreCard" parent="SafeArea/MainColumn" instance=ExtResource("9_score")]
layout_mode = 2

; ====================================================================
; GhostRecordStrip (コンポーネント): 戦績 + ストリーク
; ====================================================================
[node name="GhostRecordStrip" parent="SafeArea/MainColumn" instance=ExtResource("10_ghost")]
layout_mode = 2
size_flags_horizontal = 3

; ====================================================================
; SumiDivider (コンポーネント)
; ====================================================================
[node name="SumiDivider" parent="SafeArea/MainColumn" instance=ExtResource("11_divider")]
layout_mode = 2

; ====================================================================
; RadarCard: 6 軸レーダー (SumiRadarChart コンポーネントを washi_card に内包)
; ====================================================================
[node name="RadarCard" type="PanelContainer" parent="SafeArea/MainColumn"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"washi_card"

[node name="Margin" type="MarginContainer" parent="SafeArea/MainColumn/RadarCard"]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 12

[node name="Radar" parent="SafeArea/MainColumn/RadarCard/Margin" instance=ExtResource("12_radar")]
custom_minimum_size = Vector2(0, 244)
layout_mode = 2
size_flags_horizontal = 3

; ====================================================================
; ChallengeWrap: DailyChallengeStrip(コンポーネント) + glow CTA 重畳
; glow を帯の外周にハロー表示するため、帯を 6px インセットで重ねる。
; ====================================================================
[node name="ChallengeWrap" type="Control" parent="SafeArea/MainColumn"]
custom_minimum_size = Vector2(0, 150)
layout_mode = 2
size_flags_horizontal = 3

[node name="GlowFx" type="Control" parent="SafeArea/MainColumn/ChallengeWrap"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("5_glowcta")
corner_radius = 28.0

[node name="DailyChallengeStrip" parent="SafeArea/MainColumn/ChallengeWrap" instance=ExtResource("13_daily")]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 6.0
offset_top = 6.0
offset_right = -6.0
offset_bottom = -6.0
grow_horizontal = 2
grow_vertical = 2

; ====================================================================
; AllGamesLink: 全ゲーム一覧 (既存 nav_link 維持)
; ====================================================================
[node name="AllGamesLink" parent="SafeArea/MainColumn" instance=ExtResource("6_navlink")]
layout_mode = 2
size_flags_horizontal = 4
icon_name = "sports_esports"
label_text = "全ゲーム一覧"
direction = "forward"
