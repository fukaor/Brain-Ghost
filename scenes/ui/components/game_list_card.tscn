[gd_scene load_steps=4 format=3 uid="uid://b0gamelistcard01"]

[ext_resource type="Script" path="res://scripts/ui/components/game_list_card.gd" id="1_card"]
[ext_resource type="Texture2D" path="res://assets/textures/badges/badge_new.png" id="3_new"]
[ext_resource type="FontFile" path="res://assets/fonts/MaterialSymbolsRounded.ttf" id="5_msym"]

; ----------------------------------------------------------------------------
; GameListCard:
; ルートを Control にして、PanelContainer (washi_card) は背景レイヤとして
; アンカーフィルで配置。コンテンツ (アイコン + Name/Skill/Best) を別の
; MarginContainer に置く。NEW バッジとロックは Control 直下の絶対配置の
; 兄弟ノードにすることで、PanelContainer の子強制フィルを回避する。
;
; アイコンは game_icon_*_art.png (旧 game_icon_*.png の右側のゲームアート部分のみ
; を Python で再クロップしたクリーンアセット) を _ready 時にコントローラから差し込む。
; ----------------------------------------------------------------------------

[node name="GameListCard" type="Control"]
custom_minimum_size = Vector2(0, 112)
size_flags_horizontal = 3
size_flags_vertical = 4
script = ExtResource("1_card")

; --- 背景レイヤ (washi 紙風カード) ---
[node name="CardBg" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_type_variation = &"washi_card"

; --- コンテンツ (アイコン + テキスト) ---
[node name="Content" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 8

[node name="Row" type="HBoxContainer" parent="Content"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 10

[node name="IconArt" type="TextureRect" parent="Content/Row"]
custom_minimum_size = Vector2(96, 80)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
expand_mode = 1
stretch_mode = 5

[node name="VBox" type="VBoxContainer" parent="Content/Row"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
mouse_filter = 2
theme_override_constants/separation = 2

[node name="Name" type="Label" parent="Content/Row/VBox"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"h2"
text = "ゲーム名"
autowrap_mode = 2

[node name="Skill" type="Label" parent="Content/Row/VBox"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"caption"
text = "能力"

[node name="Best" type="Label" parent="Content/Row/VBox"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"text_light"
text = "ベスト --"

; --- NEW バッジ (Control 直下の絶対配置で右下隅に逃がす) ---
[node name="NewBadge" type="TextureRect" parent="."]
custom_minimum_size = Vector2(32, 32)
layout_mode = 1
anchors_preset = 3
anchor_left = 1.0
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = -38.0
offset_top = -38.0
offset_right = -6.0
offset_bottom = -6.0
grow_horizontal = 0
grow_vertical = 0
mouse_filter = 2
texture = ExtResource("3_new")
expand_mode = 1
stretch_mode = 5
visible = false

; --- ロックオーバーレイ (Material Symbols の鍵) ---
[node name="LockOverlay" type="Label" parent="."]
custom_minimum_size = Vector2(40, 40)
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -20.0
offset_top = -20.0
offset_right = 20.0
offset_bottom = 20.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_colors/font_color = Color(0.173, 0.173, 0.173, 0.6)
theme_override_fonts/font = ExtResource("5_msym")
theme_override_font_sizes/font_size = 36
text = "lock"
horizontal_alignment = 1
vertical_alignment = 1
visible = false
