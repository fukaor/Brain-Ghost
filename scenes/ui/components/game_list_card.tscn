[gd_scene load_steps=2 format=3 uid="uid://b0gamelistcard01"]

[ext_resource type="Script" path="res://scripts/ui/game_list_card.gd" id="1_card"]

; ----------------------------------------------------------------------------
; GameListCard (コンポーネント 2-6 / README 準拠):
;   PanelContainer (160x200) を直接ルートにし、内部は MarginContainer(12) →
;   VBox(center) → アイコン / ゲーム名 / 能力 / ベスト記録 の縦並び。
;   アイコンは Material Symbols テキスト(Icon) と将来差し替え用 TextureRect(IconTex)
;   を重ねず排他表示する。NEW バッジ / ロックオーバーレイは絶対配置の兄弟ノード。
;   bg/border の状態差分は game_list_card.gd が StyleBoxFlat を override して描画する。
; ----------------------------------------------------------------------------

[node name="GameListCard" type="PanelContainer"]
custom_minimum_size = Vector2(160, 200)
size_flags_horizontal = 4
size_flags_vertical = 4
script = ExtResource("1_card")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 12

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2
alignment = 1
theme_override_constants/separation = 6

[node name="Icon" type="Label" parent="Margin/VBox"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"icon_lg"
theme_override_font_sizes/font_size = 32
text = "sports_esports"
horizontal_alignment = 1
vertical_alignment = 1

[node name="IconTex" type="TextureRect" parent="Margin/VBox"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
mouse_filter = 2
expand_mode = 1
stretch_mode = 5
visible = false

[node name="Name" type="Label" parent="Margin/VBox"]
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(0.173, 0.173, 0.173, 1)
theme_override_font_sizes/font_size = 13
text = "ゲーム名"
horizontal_alignment = 1
autowrap_mode = 2

[node name="Ability" type="Label" parent="Margin/VBox"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"caption"
theme_override_font_sizes/font_size = 11
text = "能力"
horizontal_alignment = 1

[node name="Best" type="Label" parent="Margin/VBox"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"text_light"
theme_override_font_sizes/font_size = 10
text = "ベスト --"
horizontal_alignment = 1

; --- NEW バッジ (右上隅) ---
; PanelContainer は直下の子を矩形いっぱいに強制配置するため anchor/offset は効かない。
; ラベルを全面に敷き、文字揃え（右上）でグリフを右上隅へ寄せる。
[node name="NewBadge" type="Label" parent="."]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"icon_blue"
theme_override_colors/font_color = Color(0.784, 0.353, 0.29, 1)
theme_override_constants/line_spacing = 0
theme_override_font_sizes/font_size = 26
text = "fiber_new"
horizontal_alignment = 2
vertical_alignment = 0
visible = false

; --- ロックオーバーレイ (中央・Material Symbols の鍵) ---
; こちらも全面に敷き、文字を中央揃えで中心に配置する。
[node name="LockOverlay" type="Label" parent="."]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"icon_lg"
theme_override_colors/font_color = Color(0.549, 0.549, 0.549, 1)
theme_override_font_sizes/font_size = 40
text = "lock"
horizontal_alignment = 1
vertical_alignment = 1
visible = false
