layout_mode = 2
theme_type_variation = &"caption_on_dark_muted"
theme_override_font_sizes/font_size = 13
text = "TAP で もう一度"
horizontal_alignment = 1

; ===================================================================
; Timers
; ===================================================================
[node name="MissTimer" type="Timer" parent="."]
one_shot = true

[node name="AnnounceTimer" type="Timer" parent="."]
one_shot = true

[node name="ResultAdvanceTimer" type="Timer" parent="."]
one_shot = true
wait_time = 0.3

[connection signal="gui_input" from="TapArea" to="." method="_on_tap_area_input"]
[connection signal="timeout" from="MissTimer" to="." method="_on_miss_timer_timeout"]
[connection signal="timeout" from="AnnounceTimer" to="." method="_on_announce_timer_timeout"]
