[gd_scene load_steps=12 format=3 uid="uid://b0seqmemory001"]

[ext_resource type="Script" path="res://scripts/ui/sequence_memory_view.gd" id="1_view"]
[ext_resource type="FontFile" path="res://assets/fonts/MaterialSymbolsRounded.ttf" id="2_msym"]
[ext_resource type="FontFile" path="res://assets/fonts/NotoSansJP-Bold.otf" id="3_bold"]
[ext_resource type="Script" path="res://scripts/ui/effects/star_layer.gd" id="4_stars"]

; ----- Midnight Cat 背景 -----
[sub_resource type="Gradient" id="Gradient_nebula"]
offsets = PackedFloat32Array(0, 0.4, 1)
colors = PackedColorArray(0.04, 0.08, 0.16, 1, 0.01, 0.02, 0.04, 1, 0, 0, 0, 1)

[sub_resource type="GradientTexture2D" id="GradientTexture2D_nebula"]
gradient = SubResource("Gradient_nebula")
fill = 1
fill_from = Vector2(0.5, 0.4)
fill_to = Vector2(1, 1)

; ----- ROUND チップ (pill 形状、暗グラス + シアン枠) -----
[sub_resource type="StyleBoxFlat" id="SBF_round_chip"]
content_margin_left = 20.0
content_margin_top = 8.0
content_margin_right = 20.0
content_margin_bottom = 8.0
bg_color = Color(0.04, 0.08, 0.16, 0.7)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.435, 0.706, 1, 0.55)
corner_radius_top_left = 9999
corner_radius_top_right = 9999
corner_radius_bottom_right = 9999
corner_radius_bottom_left = 9999

; ----- タイマーチップ (右上、暗グラス) -----
[sub_resource type="StyleBoxFlat" id="SBF_timer_chip"]
content_margin_left = 14.0
content_margin_top = 8.0
content_margin_right = 14.0
content_margin_bottom = 8.0
bg_color = Color(0.067, 0.094, 0.153, 0.7)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.435, 0.706, 1, 0.3)
corner_radius_top_left = 18
corner_radius_top_right = 18
corner_radius_bottom_right = 18
corner_radius_bottom_left = 18

; ----- メモリーパネル idle (showing 未光、ほぼ透明) -----
[sub_resource type="StyleBoxFlat" id="SBF_panel_idle"]
content_margin_left = 8.0
content_margin_top = 8.0
content_margin_right = 8.0
content_margin_bottom = 8.0
bg_color = Color(0.067, 0.094, 0.153, 0.45)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.435, 0.706, 1, 0.2)
corner_radius_top_left = 18
corner_radius_top_right = 18
corner_radius_bottom_right = 18
corner_radius_bottom_left = 18
shadow_color = Color(0, 0, 0, 0.3)
shadow_size = 6
shadow_offset = Vector2(0, 4)

; ----- メモリーパネル tappable (input 中、グレー塗りで明確にタップ可能と示す) -----
[sub_resource type="StyleBoxFlat" id="SBF_panel_tappable"]
content_margin_left = 8.0
content_margin_top = 8.0
content_margin_right = 8.0
content_margin_bottom = 8.0
bg_color = Color(0.58, 0.639, 0.722, 0.5)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.78, 0.824, 0.91, 0.7)
corner_radius_top_left = 18
corner_radius_top_right = 18
corner_radius_bottom_right = 18
corner_radius_bottom_left = 18
shadow_color = Color(0, 0, 0, 0.3)
shadow_size = 6
shadow_offset = Vector2(0, 4)

[node name="SequenceMemory" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
