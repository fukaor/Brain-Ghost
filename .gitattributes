# ================================================================
# Brain Boost — .gitattributes
# Windows/Mac 混在環境でのアセット破損を防ぐ
# ================================================================

# デフォルトは LF
* text=auto eol=lf

# Godot テキストファイル
*.gd          text eol=lf
*.tscn        text eol=lf
*.tres        text eol=lf
*.cfg         text eol=lf
*.godot       text eol=lf

# ドキュメント
*.md          text eol=lf
*.json        text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf

# 画像（差分不要）
*.png         binary
*.jpg         binary
*.jpeg        binary
*.webp        binary
*.gif         binary
*.ico         binary

# 音声
*.ogg         binary
*.wav         binary
*.mp3         binary

# フォント
*.ttf         binary
*.otf         binary
*.woff        binary
*.woff2       binary

# Godot ビルド成果物
*.pck         binary
*.apk         binary
*.aab         binary
*.keystore    binary
